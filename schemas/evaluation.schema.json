{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIEvaluation",
  "type": "object",
  "required": [
    "evaluation_id",
    "use_case_id",
    "status"
  ],
  "properties": {
    "evaluation_id": {
      "type": "string"
    },
    "use_case_id": {
      "type": "string"
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "safety_critical_failures": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string"
    },
    "evaluated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
